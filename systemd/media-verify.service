[Unit]
Description=Verify the latest media-server backup restores cleanly
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=@USER@
Group=@GROUP@
WorkingDirectory=@ENGINE_DIR@
Environment=CONFIG_DIR=@CONFIG_DIR@
Environment=DATA_DIR=@DATA_DIR@
Environment=SOPS_AGE_KEY_FILE=@HOME@/.config/sops/age/keys.txt
ExecStart=@SOPS@ exec-env @CONFIG_DIR@/secrets/healthchecks.sops.env '@SOPS@ exec-env @CONFIG_DIR@/secrets/backup.sops.env scripts/verify-backup.sh'
Nice=10
IOSchedulingClass=idle
