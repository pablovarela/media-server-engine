[Unit]
Description=Back up media-server app state to B2
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=@USER@
Group=@GROUP@
SupplementaryGroups=docker
WorkingDirectory=@ENGINE_DIR@
Environment=CONFIG_DIR=@CONFIG_DIR@
Environment=DATA_DIR=@DATA_DIR@
Environment=SOPS_AGE_KEY_FILE=@HOME@/.config/sops/age/keys.txt
ExecStart=@SOPS@ exec-env @CONFIG_DIR@/secrets/healthchecks.sops.env '@SOPS@ exec-env @CONFIG_DIR@/secrets/backup.sops.env scripts/engine-run backup'
Nice=10
IOSchedulingClass=idle
