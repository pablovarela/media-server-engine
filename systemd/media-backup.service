[Unit]
Description=Back up media-server app state to B2
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=@USER@
Group=@GROUP@
SupplementaryGroups=docker
WorkingDirectory=@MEDIA_SERVER_DIR@
Environment=SOPS_AGE_KEY_FILE=@HOME@/.config/sops/age/keys.txt
ExecStart=@SOPS@ exec-env secrets/backup.sops.env scripts/backup.sh
Nice=10
IOSchedulingClass=idle
