{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "docker:pinDigests",
    "helpers:pinGitHubActionDigests"
  ],
  "dependencyDashboard": true,
  "automerge": false,
  "postUpdateOptions": [
    "gomodTidy"
  ],
  "docker-compose": {
    "managerFilePatterns": [
      "/^config-template\\/images\\.yml$/"
    ]
  },
  "packageRules": [
    {
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "/linuxserver\\//"
      ],
      "versioning": "regex:^v?(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)(?:\\.(?<build>\\d+))?-ls(?<revision>\\d+)$"
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "/linuxserver\\/jellyfin$/"
      ],
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)ubu(?<compatibility>\\d+)-ls(?<patch>\\d+)$"
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "ghcr.io/raydak-labs/configarr"
      ],
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-(?<compatibility>alpine[\\d.]+)$"
    },
    {
      "matchFileNames": [
        "config-template/**"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest",
        "pinDigest"
      ],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": false,
      "automergeStrategy": "squash"
    },
    {
      "matchFileNames": [
        "internal/restic/release.env",
        ".github/workflows/test.yml"
      ],
      "matchManagers": [
        "custom.regex"
      ],
      "prBodyNotes": [
        "Update the SHA256 pinned next to this version (for restic, the four `RESTIC_SHA256_<os>_<arch>` lines, from the release's `SHA256SUMS`): the tool-pins check fails until they match."
      ]
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^internal\\/restic\\/release\\.env$/"
      ],
      "matchStrings": [
        "RESTIC_VERSION=(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "restic/restic",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github\\/workflows\\/test\\.yml$/"
      ],
      "matchStrings": [
        "SHELLCHECK_VERSION: (?<currentValue>v\\d+\\.\\d+\\.\\d+)"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "koalaman/shellcheck"
    }
  ]
}
